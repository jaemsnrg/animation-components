        "$description": "Page ground. Everything sits on this.",
        "$value": "{color.gray.0}",
        "$extensions": {
          "mode": {
            "light": "{color.gray.0}",
            "dark": "{color.gray.975}"
          }
        }
      },
      "paper": {
        "$description": "Warm reading ground for long-form or editorial pages.",
        "$value": "{color.paper}",
        "$extensions": {
          "mode": {
            "light": "{color.paper}",
            "dark": "{color.gray.975}"
          }
        }
      },
      "card": {
