    "gray": {
      "0": {
        "$description": "Pure white. Light page ground, cards, floating surfaces; dark-theme primary button fill.",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "50": {
        "$description": "Warm off-white. Light-theme search field and input fill (bg-light-elevation).",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.98824, 0.98431, 0.98039],
          "hex": "#fcfbfa"
        }
      },
      "100": {
        "$description": "Warm light grey. Light-theme secondary button, active tab indicator, count badges (bg-elevation).",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.94902, 0.9451, 0.94118],
          "hex": "#f2f1f0"
        }
      },
      "200": {
        "$description": "Neutral light grey. Dark-theme neutral background; image placeholders.",
