{
  "$description": "Cosmos Study design tokens (DTCG format). Themed tokens carry their dark value in $extensions.mode; $value is the light value.",
  "$extensions": {
    "com.cosmos-study": {
      "source": "https://www.cosmos.so (computed styles, 2026-09-29)",
      "version": 1
    }
  },
  "color": {
